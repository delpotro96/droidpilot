<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.DroidPilot" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">?attr/isLightTheme</item>
    </style>

    <style name="Widget.DroidPilot.Log" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:textIsSelectable">true</item>
    </style>

</resources>
